FROM node:20-alpine

WORKDIR /app

# Instala dependencias primero (cachea esta capa mientras no cambie package.json)
COPY package.json package-lock.json* ./
RUN npm install

# Copia el resto del código (en dev esto se sobreescribe con el volumen del compose)
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]